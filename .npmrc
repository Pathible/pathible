# NPM Configuration for Pathible
#
# NOTE: Warnings about "verify-deps-before-run" and "_jsr-registry" during builds
# are benign and come from pnpm's environment when calling npx. These cannot be
# suppressed locally and will be resolved in future pnpm versions.
# See: https://github.com/pnpm/pnpm/issues/8559

# JSR registry for @jsr packages
@jsr:registry=https://npm.jsr.io/
