#!/usr/bin/env sh

# Pre-commit hook for Pathible
# Ensures code quality before commits

echo "Running pre-commit checks..."

# 1. Lint check (Biome + TypeScript)
echo "Step 1/3: Running lint..."
pnpm lint || {
  echo "Lint failed. Please fix errors before committing."
  exit 1
}

# 2. Unit tests (fast, catches logic errors)
echo "Step 2/3: Running unit tests..."
pnpm test || {
  echo "Unit tests failed. Please fix failing tests before committing."
  exit 1
}

# 3. Build check (Next.js + Convex)
echo "Step 3/3: Running build..."
pnpm build || {
  echo "Build failed. Please fix errors before committing."
  exit 1
}

# Note: E2E tests are run in CI on every PR
# To run E2E tests locally: pnpm dev & pnpm test:e2e
# Feature tests: npx cypress run --spec "cypress/e2e/features/**/*.cy.ts"

echo "All pre-commit checks passed!"
