{
  "name": "pathible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:frontend & pnpm run dev:backend",
    "dev:backend": "convex dev --typecheck-components --live-component-sources",
    "dev:frontend": "next dev",
    "generate": "convex dev --once --typecheck-components",
    "build": "pnpm exec convex codegen && next build",
    "build:vercel": "pnpm exec convex deploy && next build",
    "build:ci": "next build",
    "start": "next start",
    "lint": "biome check && tsc -p src/convex && tsc --noEmit",
    "lint:icons": "! grep -rE 'from \"lucide-react\"' src/ --include='*.tsx' | grep -E '\\b(Edit|Edit2|Edit3|Trash[^2])\\b' || echo 'Icon standards OK'",
    "kill": "pkill -f 'next dev' 2>/dev/null || echo 'All clear'",
    "cypress": "cypress open",
    "cypress:headless": "cypress run",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:ci": "cypress run --browser chrome --headless",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:legal-docs": "vitest run src/lib/__tests__",
    "update-everything": "pnpm update --latest",
    "prepare": "husky",
    "verify:prod": "./scripts/verify-production.sh",
    "linecount": "cloc . --exclude-dir=node_modules,dist,build,coverage,.next --exclude-ext=json,lock,md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@clerk/backend": "^3.23.0",
    "@clerk/nextjs": "^7.9.11",
    "@clerk/react": "^6.17.6",
    "@clerk/shared": "^4.39.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-table": "^9.2.6",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "framer-motion": "^14.0.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.2",
    "posthog-node": "^5.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.32.1",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "svix": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@clerk/testing": "^2.2.43",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "convex-test": "^0.0.60",
    "cypress": "^16.1.1",
    "dotenv": "^18.0.6",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/typography>postcss-selector-parser": "7.1.6",
      "@clerk/clerk-react": "npm:@clerk/react@6.17.6"
    }
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
