{
    "name": "pathible",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "pnpm run dev:frontend & pnpm run dev:backend",
        "dev:backend": "convex dev --typecheck-components --live-component-sources",
        "dev:frontend": "next dev",
        "generate": "convex dev --once --typecheck-components",
        "build": "npx convex codegen && next build",
        "build:vercel": "npx convex deploy && next build",
        "build:ci": "next build",
        "start": "next start",
        "lint": "biome check --write && tsc -p src/convex && npx tsc --noEmit",
        "lint:icons": "! grep -rE 'from \"lucide-react\"' src/ --include='*.tsx' | grep -E '\\b(Edit|Edit2|Edit3|Trash[^2])\\b' || echo 'Icon standards OK'",
        "kill": "pkill -f 'next dev' 2>/dev/null || echo 'All clear'",
        "cypress": "cypress open",
        "cypress:headless": "cypress run",
        "test:e2e": "cypress run",
        "test:e2e:open": "cypress open",
        "test:e2e:ci": "cypress run --browser chrome --headless",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:legal-docs": "vitest run --testPathPattern=legal-documents",
        "update-everything": "up --latest",
        "prepare": "husky",
        "verify:prod": "./scripts/verify-production.sh",
        "linecount": "cloc . --exclude-dir=node_modules,dist,build,coverage,.next --exclude-ext=json,lock,md"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.966.0",
        "@aws-sdk/s3-request-presigner": "^3.966.0",
        "@clerk/nextjs": "^6.36.7",
        "@clerk/types": "^4.101.10",
        "@hookform/resolvers": "^5.2.2",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-alert-dialog": "^1.1.15",
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-checkbox": "^1.3.3",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-radio-group": "^1.3.8",
        "@radix-ui/react-select": "^2.2.6",
        "@radix-ui/react-separator": "^1.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@react-pdf/renderer": "^4.3.2",
        "@tailwindcss/typography": "^0.5.19",
        "@tanstack/react-table": "^8.21.3",
        "@vercel/analytics": "^1.6.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "convex": "^1.31.3",
        "framer-motion": "^12.25.0",
        "input-otp": "^1.4.2",
        "lucide-react": "^0.562.0",
        "next": "16.1.1",
        "next-themes": "^0.4.6",
        "posthog-js": "^1.328.0",
        "posthog-node": "^5.21.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.70.0",
        "react-markdown": "^10.1.0",
        "resend": "^6.7.0",
        "sonner": "^2.0.7",
        "stripe": "^20.4.1",
        "svix": "^1.84.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.11",
        "@clerk/testing": "^1.13.28",
        "@playwright/test": "^1.58.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.1",
        "@types/node": "^25.0.6",
        "@types/react": "^19.2.8",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.0.16",
        "cypress": "^15.8.2",
        "dotenv": "^17.2.3",
        "eslint": "^9.39.2",
        "eslint-config-next": "16.1.1",
        "husky": "^9.1.7",
        "jsdom": "^27.4.0",
        "lint-staged": "^16.2.7",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.16"
    }
}