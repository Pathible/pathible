# =============================================================================
# PATHIBLE ENVIRONMENT CONFIGURATION
# =============================================================================
#
# Copy this file to .env.local for development:
#   cp .env.example .env.local
#
# For testing, copy to .env.test:
#   cp .env.example .env.test
#
# IMPORTANT: Never commit .env.local or .env.test with real credentials!
#
# =============================================================================


# =============================================================================
# CONVEX BACKEND
# =============================================================================
# Convex is the real-time backend database for Pathible.
# Get these values from: https://dashboard.convex.dev
#
# 1. Create a new project or select existing one
# 2. Go to Settings > URL & Deploy Key
# 3. Copy the deployment URL

# Deployment identifier (format: dev:project-name-123 or prod:project-name-123)
CONVEX_DEPLOYMENT=dev:your-project-name

# Public URL for client-side Convex queries (ends in .convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# Site URL for HTTP actions (ends in .convex.site)
# Used for webhooks and server-to-server communication
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project-name.convex.site

# Same as above - required by Convex auth configuration
CONVEX_SITE_URL=https://your-project-name.convex.site


# =============================================================================
# APPLICATION URLs
# =============================================================================
# Base URL of your application - used for authentication redirects and CORS

# Local development
SITE_URL=http://localhost:3000

# Production (uncomment and set for production deployment)
# SITE_URL=https://app.pathible.com


# =============================================================================
# CLERK AUTHENTICATION
# =============================================================================
# Clerk handles user authentication (login, signup, sessions).
# Get these values from: https://dashboard.clerk.com
#
# 1. Create a new application or select existing one
# 2. Go to API Keys in the sidebar
# 3. Copy both keys

# Publishable key (safe to expose in browser - starts with pk_test_ or pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key (NEVER expose publicly - starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Billing Configuration
# Controls whether subscription/plan enforcement is active
# Set to 'true' in production to enforce plan limits
# Set to 'false' or omit for development (bypasses subscription checks)
NEXT_PUBLIC_BILLING_ENABLED=false


# =============================================================================
# EMAIL SERVICE (RESEND)
# =============================================================================
# Resend handles transactional emails (OTP codes, notifications).
# Get your API key from: https://resend.com/api-keys
#
# DEVELOPMENT NOTE:
# - Without RESEND_API_KEY, OTP codes are logged to the console
# - This is useful for local development without email setup
#
# PRODUCTION REQUIREMENTS:
# - Must configure RESEND_API_KEY
# - Must verify your sending domain in Resend dashboard

# API key from Resend dashboard (starts with re_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email sender configuration
# The domain in EMAIL_FROM_ADDRESS must be verified in Resend
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Pathible


# =============================================================================
# FILE STORAGE (BACKBLAZE B2)
# =============================================================================
# Backblaze B2 stores user-uploaded documents in the Heritage Vault.
# Uses S3-compatible API for browser-based uploads with presigned URLs.
#
# Setup Instructions:
# 1. Create a Backblaze B2 account: https://www.backblaze.com/b2/cloud-storage.html
# 2. Create a new bucket (private, with default settings)
# 3. Create an Application Key with read/write access to your bucket
# 4. Get your S3 endpoint from bucket settings (varies by region)
#
# CORS Configuration:
# Add this CORS rule to your bucket (in bucket settings):
# [
#   {
#     "corsRuleName": "pathible-uploads",
#     "allowedOrigins": ["http://localhost:3000", "https://yourdomain.com"],
#     "allowedHeaders": ["*"],
#     "allowedOperations": ["s3_head", "s3_get", "s3_put"],
#     "exposeHeaders": ["ETag"],
#     "maxAgeSeconds": 3600
#   }
# ]

# S3-compatible endpoint (varies by region, check bucket settings)
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Region identifier (matches your bucket's region)
B2_S3_REGION=us-west-004

# Application Key ID (NOT the master key - create an app-specific key)
B2_S3_ACCESS_KEY_ID=your_application_key_id

# Application Key Secret
B2_S3_SECRET_ACCESS_KEY=your_application_key_secret

# Bucket name (must match exactly, case-sensitive)
B2_S3_BUCKET_NAME=your-bucket-name


# =============================================================================
# E2E TESTING (CYPRESS + CLERK)
# =============================================================================
# These variables enable automated E2E testing with Clerk authentication.
# The @clerk/testing package uses these to bypass OTP and automate login.
#
# HOW IT WORKS:
# - Clerk Testing Tokens allow automated sign-in without OTP
# - Tests can programmatically authenticate users
# - No manual intervention needed for auth flows
#
# IMPORTANT - TEST EMAIL FORMAT:
# Clerk Testing Tokens REQUIRE emails with the "+clerk_test" subaddress pattern.
# Example: yourname+clerk_test@gmail.com
# Read more: https://clerk.com/docs/testing/test-emails-and-phones
#
# SETUP:
# 1. Use the same Clerk keys as above (CLERK_SECRET_KEY is required)
# 2. Create a test user in Clerk dashboard with +clerk_test email pattern
# 3. Log into your app as this user to create their profile and household
# 4. Update this variable with your test user email
# 5. Run tests with: pnpm test:e2e

# Test user email - MUST use +clerk_test subaddress pattern!
# Create this user in Clerk dashboard: https://dashboard.clerk.com
# This user should have a profile and household set up for vault tests
CYPRESS_TEST_USER_EMAIL=jamesvgibbs+clerk_test@gmail.com

# Alternative: Use environment variable prefix for Cypress
# Cypress automatically picks up CYPRESS_* variables
# CYPRESS_CLERK_PUBLISHABLE_KEY=${NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY}


# =============================================================================
# ANALYTICS (POSTHOG)
# =============================================================================
# PostHog provides product analytics, event tracking, and user insights.
# Get these values from: https://app.posthog.com/settings/project
#
# 1. Create a PostHog account at https://posthog.com
# 2. Create a new project or select existing one
# 3. Go to Settings > Project > Project API Key
# 4. Copy the Project API Key (starts with phc_)
#
# PostHog tracks:
# - Page views (automatic)
# - User interactions (automatic)
# - Custom events (article views, conversions, etc.)
# - Session recordings (optional)

# Project API Key (safe to expose in browser - starts with phc_)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostHog host URL (use US or EU based on your data residency needs)
# US: https://us.i.posthog.com
# EU: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# =============================================================================
# OPTIONAL: DEVELOPMENT OVERRIDES
# =============================================================================
# These are optional settings that can help during development

# Enable verbose logging (uncomment to enable)
# DEBUG=true

# Skip certain checks during development (uncomment to enable)
# SKIP_ENV_VALIDATION=true
